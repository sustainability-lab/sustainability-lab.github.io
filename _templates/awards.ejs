<% let year = null; %>
<div class="awards">
<% for (const a of items) { if (a.year !== year) { year = a.year; %><div class="year" id="<%= a.category.toLowerCase() %>-<%= year %>"><%= year %></div><% } %>
<div class="award-row">
<div class="award-text">
<h3><%= a.title %></h3>
<p class="who"><%= a.who %><% if (a.when) { %> · <%= a.when %><% } %></p>
<% if (a.detail) { %><p class="muted"><%= String(a.detail).replace(/\*/g,'&#42;') %></p><% } %>
<% if (a.links) { %><p class="small"><% for (const l of a.links) { %><a href="<%= l.url %>"><%= l.label %></a> <% } %></p><% } %>
</div>
<% if (a.photos) { %><div class="award-photos"><% for (const p of a.photos) { %><a href="<%= p.src %>" class="lightbox" data-gallery="award-<%= year %>-<%= a.title.length %>" title="<%= p.alt %>"><img src="<%= p.src %>" alt="<%= p.alt %>" loading="lazy"></a><% } %></div><% } %>
</div>
<% } %>
</div>
