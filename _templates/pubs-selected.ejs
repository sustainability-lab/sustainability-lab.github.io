<div class="sel">
<% for (const p of items) { %>
<a href="<%= (p.links && p.links.length) ? p.links[0].url : '#' %>"><img<%= p.figure_dark ? ' class="has-dark"' : '' %> src="<%= p.figure %>" alt="" loading="lazy"><% if (p.figure_dark) { %><img class="fig-dark" src="<%= p.figure_dark %>" alt="" loading="lazy"><% } %><b><%= p.short || p.title %></b><span><%= p.venue_short || p.venue %><% if (p.award) { %> · <%= p.award %><% } %></span></a>
<% } %>
</div>
